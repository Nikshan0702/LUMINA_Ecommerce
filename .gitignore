# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/

# ==========================================
# Environment Variables & Secrets
# (Never commit private keys, credentials, or DB URIs)
# ==========================================
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example

# ==========================================
# Production Builds & Bundler Caches
# ==========================================
dist/
build/
client/dist/
client/build/
.vite/
client/.vite/
.parcel-cache/

# ==========================================
# Logs & Diagnostic Files
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Operating System & Editor Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor caches
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sublime-workspace
*.sublime-project
